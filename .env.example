# Environment Configuration File
# Copy this to .env and fill in your actual values

# Flask Configuration
FLASK_ENV=development
FLASK_APP=backend/app.py
SECRET_KEY=your-secret-key-change-in-production
DEBUG=True

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/fake-news-detector
DATABASE_NAME=fake-news-detector

# API Configuration
HOST=0.0.0.0
PORT=5000
MAX_CONTENT_LENGTH=16777216

# API Keys
GOOGLE_FACTCHECK_API_KEY=your-google-fact-check-api-key
NEWSAPI_KEY=your-newsapi-key
API_KEY=demo-key

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# ML Model Configuration
MODEL_TYPE=ensemble
MODEL_PATH=./backend/models
BATCH_SIZE=32
MAX_SEQUENCE_LENGTH=512

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# Cache Configuration
CACHE_TYPE=simple
CACHE_DEFAULT_TIMEOUT=300

# Security
RATE_LIMIT=60  # requests per minute
MAX_BATCH_SIZE=100

# Features
ENABLE_SENTIMENT_ANALYSIS=True
ENABLE_PROPAGANDA_DETECTION=True
ENABLE_FACT_CHECKING=True
ENABLE_SOURCE_ANALYSIS=True

# Development
TESTING=False
