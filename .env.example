# ============================================================================
# FAKE NEWS DETECTION SYSTEM - ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to .env and fill in your actual values

# ============================================================================
# FLASK CONFIGURATION
# ============================================================================
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_APP=backend.app:app
SECRET_KEY=your-super-secret-key-change-this-in-production

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
HOST=0.0.0.0
PORT=5000
WORKERS=4

# ============================================================================
# API KEYS & CREDENTIALS
# ============================================================================

# Google Fact Check API
GOOGLE_FACT_CHECK_API_KEY=your-google-fact-check-api-key

# NewsAPI
NEWS_API_KEY=your-newsapi-key

# OpenWeatherMap (optional)
OPENWEATHER_API_KEY=your-openweather-key

# Hugging Face (for advanced NLP models)
HUGGINGFACE_API_KEY=your-huggingface-token

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/fake-news-detector
MONGODB_USER=admin
MONGODB_PASSWORD=your-mongodb-password

# Firebase
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_DATABASE_URL=https://your-project.firebaseio.com

# PostgreSQL (optional)
DATABASE_URL=postgresql://user:password@localhost:5432/fake_news_db

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================

# API Key for protected endpoints
API_KEY=demo-key-change-in-production

# JWT Configuration
JWT_SECRET=your-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRATION=3600

# CORS Settings
CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# ============================================================================
# ML MODEL CONFIGURATION
# ============================================================================

# Model Selection
MODEL_TYPE=ensemble
USE_BERT=True
USE_ENSEMBLE=True

# Model Paths
MODEL_DIR=backend/models
DATA_DIR=data

# BERT Model Configuration
BERT_MODEL_NAME=distilbert-base-uncased-finetuned-sst-2-english
TRANSFORMERS_CACHE=./cache/transformers

# ============================================================================
# LOGGING & MONITORING
# ============================================================================

# Logging Settings
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Sentry (Error tracking)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ============================================================================
# EXTERNAL SERVICES & INTEGRATIONS
# ============================================================================

# Image Verification
GOOGLE_VISION_API_KEY=your-google-vision-api-key

# WhatsApp Integration
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Twitter Integration
TWITTER_API_KEY=your-twitter-api-key
TWITTER_API_SECRET=your-twitter-api-secret
TWITTER_ACCESS_TOKEN=your-twitter-access-token
TWITTER_ACCESS_SECRET=your-twitter-access-secret

# ============================================================================
# FEATURE FLAGS
# ============================================================================

ENABLE_SENTIMENT_ANALYSIS=True
ENABLE_PROPAGANDA_DETECTION=True
ENABLE_FACT_CHECKING=True
ENABLE_SOURCE_CREDIBILITY=True
ENABLE_IMAGE_VERIFICATION=False
ENABLE_MULTILINGUAL=True
ENABLE_ANALYTICS_DASHBOARD=True
ENABLE_USER_REPORTS=True

# ============================================================================
# PERFORMANCE & CACHING
# ============================================================================

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
CACHE_TYPE=redis
CACHE_REDIS_URL=redis://localhost:6379/1
CACHE_DEFAULT_TIMEOUT=3600

# ============================================================================
# LANGUAGE & LOCALIZATION
# ============================================================================

# Supported Languages
SUPPORTED_LANGUAGES=en,hi,es,fr,de,zh,ar
DEFAULT_LANGUAGE=en

# ============================================================================
# DEPLOYMENT
# ============================================================================

# Environment Type
ENVIRONMENT=development

# AWS Configuration
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=your-s3-bucket-name
AWS_REGION=us-east-1

# GCP Configuration
GCP_PROJECT_ID=your-gcp-project-id
GCP_CREDENTIALS_FILE=/path/to/credentials.json

# ============================================================================
# CHROME EXTENSION CONFIGURATION
# ============================================================================

# Extension Settings
EXTENSION_ID=your-chrome-extension-id
EXTENSION_VERSION=1.0.0

# ============================================================================
# CUSTOM SETTINGS
# ============================================================================

# Request Limits
MAX_TEXT_LENGTH=50000
MAX_BATCH_SIZE=100
MAX_CONTENT_LENGTH=16777216
REQUESTS_PER_MINUTE=60

# Sensitivity Settings
FAKE_NEWS_THRESHOLD=0.5
CONFIDENCE_THRESHOLD=0.7

# UI Configuration
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# ============================================================================
# NOTES
# ============================================================================
# 1. Never commit the .env file with actual credentials to version control
# 2. Use a secure vault for production credentials
# 3. Keep separate .env files for dev, staging, and production
# 4. Always use HTTPS in production
# 5. Rotate API keys regularly

# Development
TESTING=False
